# Summary only. Each app has its own .env.example (apps/server, apps/web, apps/mobile); use those.

# Backend (Render / local)
PORT=4000
MONGODB_URI=
JWT_SECRET=
CLIENT_ORIGINS=http://localhost:5173,http://localhost:3000

# Web (Vercel / local) — name must match your bundler (e.g. VITE_API_URL)
VITE_API_URL=http://localhost:4000

# Mobile (Expo) — set to the deployed Render URL for APK builds, not localhost
EXPO_PUBLIC_API_URL=http://localhost:4000
