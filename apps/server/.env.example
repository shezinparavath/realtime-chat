# Copy to .env for local runs. Never commit real secrets.
PORT=4000
# Leave empty to run without a DB (/health works; auth/data routes return 500 SERVER_ERROR).
# Local example: mongodb://127.0.0.1:27017/realtime-chat
MONGODB_URI=
# Required for auth + sockets (HS256). Use a long random value in production.
JWT_SECRET=change-me-in-production
# Comma-separated allowed origins (Express + Socket.IO CORS)
# REQUIRED when NODE_ENV=production: the server refuses to start if empty.
CLIENT_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000
# Alias also accepted: CORS_ORIGIN
NODE_ENV=development

# --- npm run seed only (RTC-P6-02). Passwords have NO defaults; never commit real ones.
# SEED_USER1_EMAIL=demo.alice@example.com
# SEED_USER1_USERNAME=demo_alice
SEED_USER1_PASSWORD=
# SEED_USER2_EMAIL=demo.bob@example.com
# SEED_USER2_USERNAME=demo_bob
SEED_USER2_PASSWORD=
# Required (=yes) to seed a non-localhost MongoDB
# SEED_CONFIRM=

# --- Client IP for auth rate limits (DEF-001). Unset = defaults by NODE_ENV; explicit values always win.
# Proxy hops to skip from the right of X-Forwarded-For (Express 'trust proxy'). Integer 0-10.
# Default: 3 when NODE_ENV=production (Render: client, cloudflare, render LB), 1 otherwise.
# Must equal the REAL hop count: too high lets clients forge their key; too low merges everyone into one counter.
# TRUST_PROXY_HOPS=
# Header with the client IP set by the edge proxy; limiter falls back to req.ip if it's missing/invalid.
# Default: CF-Connecting-IP when NODE_ENV=production (Cloudflare 403s client-sent values), none otherwise.
# 'none' disables it. True-Client-IP / X-Real-IP / CF-Connecting-IPv6 / X-Forwarded-For are refused (forgeable on Render).
# CLIENT_IP_HEADER=
# 1 = log XFF chain length + key source per auth request (never IPs). Leave off normally.
# RATE_LIMIT_DEBUG=
