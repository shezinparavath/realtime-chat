# Copy to .env for local runs. Never commit real secrets.
PORT=4000
# Leave empty to run without a DB (/health works; auth/data routes return 500 SERVER_ERROR).
# Local example: mongodb://127.0.0.1:27017/realtime-chat
MONGODB_URI=
# Required for auth + sockets (HS256). Use a long random value in production.
JWT_SECRET=change-me-in-production
# Comma-separated allowed origins (Express + Socket.IO CORS)
CLIENT_ORIGINS=http://localhost:5173,http://localhost:3000
# Alias also accepted: CORS_ORIGIN
NODE_ENV=development
